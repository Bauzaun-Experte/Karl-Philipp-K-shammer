{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "WhatsApp-Mail-Bruecke der Bauzaun-Experte GmbH: nimmt Webhooks der WhatsApp Cloud API (Meta) an, laedt Bilder und Dokumente herunter und schickt sie als Mail an info@. Verifizierung (GET mit hub.challenge) und Ereignisse (POST) laufen ueber dieselbe URL."
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "whatsapp-mail-bruecke",
      "metadata": { "description": "Name der Logic App" }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure-Region, z. B. germanywestcentral" }
    },
    "metaVerifyToken": {
      "type": "securestring",
      "metadata": { "description": "Frei gewaehltes Verify-Token; dasselbe in der Meta-Webhook-Konfiguration eintragen" }
    },
    "metaAccessToken": {
      "type": "securestring",
      "metadata": { "description": "Dauerhaftes System-User-Token aus dem Meta Business Manager (Berechtigung whatsapp_business_messaging)" }
    },
    "graphVersion": {
      "type": "string",
      "defaultValue": "v23.0",
      "metadata": { "description": "Version der Meta Graph API fuer den Medien-Download" }
    },
    "mailTo": {
      "type": "string",
      "defaultValue": "info@bauzaun-experte.de",
      "metadata": { "description": "Zielpostfach; muss das Postfach sein, das die Routinen lesen" }
    }
  },
  "variables": {
    "connectionName": "office365-whatsapp-bruecke",
    "office365ApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Office 365 Outlook (WhatsApp-Mail-Bruecke)",
        "api": { "id": "[variables('office365ApiId')]" }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('connectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connectionName'))]",
                "connectionName": "[variables('connectionName')]",
                "id": "[variables('office365ApiId')]"
              }
            }
          },
          "metaVerifyToken": { "value": "[parameters('metaVerifyToken')]" },
          "metaAccessToken": { "value": "[parameters('metaAccessToken')]" },
          "graphVersion": { "value": "[parameters('graphVersion')]" },
          "mailTo": { "value": "[parameters('mailTo')]" }
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "type": "Object", "defaultValue": {} },
            "metaVerifyToken": { "type": "SecureString" },
            "metaAccessToken": { "type": "SecureString" },
            "graphVersion": { "type": "String", "defaultValue": "v23.0" },
            "mailTo": { "type": "String", "defaultValue": "info@bauzaun-experte.de" }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {}
            }
          },
          "actions": {
            "Ist_Verifizierung": {
              "type": "If",
              "runAfter": {},
              "expression": "@equals(triggerOutputs()?['queries']?['hub.mode'], 'subscribe')",
              "actions": {
                "Verify_Token_pruefen": {
                  "type": "If",
                  "runAfter": {},
                  "expression": "@equals(triggerOutputs()?['queries']?['hub.verify_token'], parameters('metaVerifyToken'))",
                  "actions": {
                    "Antwort_Challenge": {
                      "type": "Response",
                      "kind": "Http",
                      "runAfter": {},
                      "inputs": {
                        "statusCode": 200,
                        "headers": { "Content-Type": "text/plain" },
                        "body": "@triggerOutputs()?['queries']?['hub.challenge']"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Antwort_403": {
                        "type": "Response",
                        "kind": "Http",
                        "runAfter": {},
                        "inputs": { "statusCode": 403, "body": "Verify-Token falsch" }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Antwort_200": {
                    "type": "Response",
                    "kind": "Http",
                    "runAfter": {},
                    "inputs": { "statusCode": 200, "body": "EVENT_RECEIVED" }
                  },
                  "Je_Eintrag": {
                    "type": "Foreach",
                    "runAfter": { "Antwort_200": ["Succeeded"] },
                    "foreach": "@coalesce(triggerBody()?['entry'], json('[]'))",
                    "actions": {
                      "Je_Aenderung": {
                        "type": "Foreach",
                        "runAfter": {},
                        "foreach": "@coalesce(items('Je_Eintrag')?['changes'], json('[]'))",
                        "actions": {
                          "Je_Nachricht": {
                            "type": "Foreach",
                            "runAfter": {},
                            "foreach": "@coalesce(items('Je_Aenderung')?['value']?['messages'], json('[]'))",
                            "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
                            "actions": {
                              "Absender": {
                                "type": "Compose",
                                "runAfter": {},
                                "inputs": "@coalesce(items('Je_Aenderung')?['value']?['contacts']?[0]?['profile']?['name'], items('Je_Nachricht')?['from'])"
                              },
                              "Zeit": {
                                "type": "Compose",
                                "runAfter": { "Absender": ["Succeeded"] },
                                "inputs": "@convertTimeZone(addSeconds('1970-01-01T00:00:00Z', int(coalesce(items('Je_Nachricht')?['timestamp'], '0'))), 'UTC', 'W. Europe Standard Time', 'dd.MM.yyyy HH:mm')"
                              },
                              "Medien_ID": {
                                "type": "Compose",
                                "runAfter": { "Zeit": ["Succeeded"] },
                                "inputs": "@coalesce(items('Je_Nachricht')?['image']?['id'], items('Je_Nachricht')?['document']?['id'], '')"
                              },
                              "Text": {
                                "type": "Compose",
                                "runAfter": { "Medien_ID": ["Succeeded"] },
                                "inputs": "@coalesce(items('Je_Nachricht')?['image']?['caption'], items('Je_Nachricht')?['document']?['caption'], items('Je_Nachricht')?['text']?['body'], '')"
                              },
                              "Hat_Anhang": {
                                "type": "If",
                                "runAfter": { "Text": ["Succeeded"] },
                                "expression": "@not(empty(outputs('Medien_ID')))",
                                "actions": {
                                  "Medien_Info": {
                                    "type": "Http",
                                    "runAfter": {},
                                    "inputs": {
                                      "method": "GET",
                                      "uri": "https://graph.facebook.com/@{parameters('graphVersion')}/@{outputs('Medien_ID')}",
                                      "headers": { "Authorization": "Bearer @{parameters('metaAccessToken')}" }
                                    }
                                  },
                                  "Medien_Download": {
                                    "type": "Http",
                                    "runAfter": { "Medien_Info": ["Succeeded"] },
                                    "inputs": {
                                      "method": "GET",
                                      "uri": "@body('Medien_Info')?['url']",
                                      "headers": {
                                        "Authorization": "Bearer @{parameters('metaAccessToken')}",
                                        "User-Agent": "whatsapp-mail-bruecke/1.0"
                                      }
                                    }
                                  },
                                  "Dateiname": {
                                    "type": "Compose",
                                    "runAfter": { "Medien_Download": ["Succeeded"] },
                                    "inputs": "@coalesce(items('Je_Nachricht')?['document']?['filename'], concat('WhatsApp_', formatDateTime(utcNow(), 'yyyyMMdd-HHmm'), '_', outputs('Medien_ID'), if(equals(body('Medien_Info')?['mime_type'], 'image/png'), '.png', if(equals(body('Medien_Info')?['mime_type'], 'application/pdf'), '.pdf', '.jpg'))))"
                                  },
                                  "Mail_mit_Anhang": {
                                    "type": "ApiConnection",
                                    "runAfter": { "Dateiname": ["Succeeded"] },
                                    "inputs": {
                                      "host": { "connection": { "name": "@parameters('$connections')['office365']['connectionId']" } },
                                      "method": "post",
                                      "path": "/v2/Mail",
                                      "body": {
                                        "To": "@parameters('mailTo')",
                                        "Subject": "[WhatsApp] Lieferschein von @{outputs('Absender')} (+@{items('Je_Nachricht')?['from']})@{if(empty(outputs('Text')), '', concat(': ', outputs('Text')))}",
                                        "Body": "<p>Automatisch aus WhatsApp weitergeleitet (Logic App WhatsApp-Mail-Bruecke).</p><p>Von: @{outputs('Absender')} (+@{items('Je_Nachricht')?['from']})<br>Zeit: @{outputs('Zeit')}<br>Text: @{outputs('Text')}</p><p>WhatsApp-Nachrichten-ID: @{items('Je_Nachricht')?['id']}<br>Medien-ID: @{outputs('Medien_ID')}</p>",
                                        "Importance": "Normal",
                                        "Attachments": [
                                          {
                                            "Name": "@{outputs('Dateiname')}",
                                            "ContentBytes": "@{base64(body('Medien_Download'))}"
                                          }
                                        ]
                                      }
                                    }
                                  }
                                },
                                "else": {
                                  "actions": {
                                    "Nur_Text": {
                                      "type": "If",
                                      "runAfter": {},
                                      "expression": "@not(empty(outputs('Text')))",
                                      "actions": {
                                        "Mail_Text": {
                                          "type": "ApiConnection",
                                          "runAfter": {},
                                          "inputs": {
                                            "host": { "connection": { "name": "@parameters('$connections')['office365']['connectionId']" } },
                                            "method": "post",
                                            "path": "/v2/Mail",
                                            "body": {
                                              "To": "@parameters('mailTo')",
                                              "Subject": "[WhatsApp] Nachricht von @{outputs('Absender')} (+@{items('Je_Nachricht')?['from']}): @{outputs('Text')}",
                                              "Body": "<p>Automatisch aus WhatsApp weitergeleitet (Logic App WhatsApp-Mail-Bruecke).</p><p>Von: @{outputs('Absender')} (+@{items('Je_Nachricht')?['from']})<br>Zeit: @{outputs('Zeit')}</p><p>@{outputs('Text')}</p><p>WhatsApp-Nachrichten-ID: @{items('Je_Nachricht')?['id']}</p>",
                                              "Importance": "Normal"
                                            }
                                          }
                                        }
                                      },
                                      "else": { "actions": {} }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        }
      }
    }
  ],
  "outputs": {
    "callbackUrl": {
      "type": "string",
      "value": "[listCallbackUrl(resourceId('Microsoft.Logic/workflows/triggers', parameters('logicAppName'), 'manual'), '2019-05-01').value]"
    }
  }
}
